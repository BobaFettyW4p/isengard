#!/usr/bin/env bash
# agent: run Claude Code agents as a git worktree + tmux session.
set -euo pipefail

AGENTS_HOME="${AGENTS_HOME:-$HOME/agents}"
REPOS="$AGENTS_HOME/repos"
WORK="$AGENTS_HOME/work"
STATE="$AGENTS_HOME/state"
EVENTS="$AGENTS_HOME/events.log"
ALLOWLIST="$AGENTS_HOME/allowlist.json"
AGENT_CMD="${AGENT_CMD:-claude}"
MEM_MAX="${AGENT_MEM_MAX:-8G}"
CPU_QUOTA="${AGENT_CPU_QUOTA:-800%}"
BIN="$HOME/.local/bin/agent"

# Sandbox (--sandbox) settings.
IMAGE="${AGENT_IMAGE:-isengard-agent}"
TOKEN_SECRET="${AGENT_TOKEN_SECRET:-claude-oauth-token}"
SANDBOX_CMD="${AGENT_SANDBOX_CMD:-claude --dangerously-skip-permissions}"
SANDBOX_MEM="${AGENT_SANDBOX_MEM:-8g}"
SANDBOX_CPUS="${AGENT_SANDBOX_CPUS:-8}"
SB_FLAGS=(--userns=keep-id:uid=1000,gid=1000 --cap-drop=ALL --security-opt=no-new-privileges
          --memory="$SANDBOX_MEM" --cpus="$SANDBOX_CPUS" --pids-limit=2048 --tz=local)

die() { echo "agent: $*" >&2; exit 1; }
now() { date +%s; }
sess() { echo "agent-$1"; }

usage() {
  cat <<'EOF'
usage: agent <command>

  new [--sandbox] [--edit | --file <path>] <repo> <name> [task... | -]
                                worktree + tmux session + claude (task = first prompt).
                                For long prompts: --edit writes it in $VISUAL/$EDITOR,
                                --file reads it from a file, "-" reads it from stdin
                                --sandbox: run in a Podman container with its own clone,
                                no permission prompts, no GitHub credentials (marked [sb])
                                <repo>: owner/name (cloned with gh), a git URL, a
                                name under ~/agents/repos, or a path to a local repo
  ls                            all agents: status, age, last output line
  peek <name> [lines]           print the agent's recent terminal output
  attach <name>                 attach to its tmux session (detach: Ctrl-b d)
  diff <name>                   commits and changes on the agent's branch
  push <name>                   push the agent's branch (host GitHub login)
  pr <name> [gh args]           push, then open a PR against the default branch
  log [n]                       recent events (needs-you / done)
  rm <name> [--force]           stop the agent, remove its worktree/clone (branch is kept)
  clean [-n] [name...]          remove agents whose PR is merged (and delete their branch);
                                keeps the rest. No names = every agent. -n = dry run
  setup                         create ~/agents, default allowlist, install hooks
  image build                   build the sandbox image
  token set|status|rm           manage the Claude token the sandbox uses

statuses: working | needs-you | done | exited | gone | OFF-BRANCH
EOF
}

set_status() { printf '%s %s\n' "$2" "$(now)" > "$STATE/$1.status"; }
log_event() { printf '%s %-14s %-10s %s\n' "$(date '+%F %T')" "$1" "$2" "$3" >> "$EVENTS"; }

load() {
  [[ -f "$STATE/$1.env" ]] || die "no such agent: $1"
  # shellcheck disable=SC1090
  source "$STATE/$1.env"
}

human_age() {
  local s=$1
  if   (( s < 60 ));    then echo "${s}s"
  elif (( s < 3600 ));  then echo "$((s / 60))m"
  elif (( s < 86400 )); then echo "$((s / 3600))h"
  else echo "$((s / 86400))d"; fi
}

resolve_repo() {
  local spec="$1" base dest
  if [[ -d "$REPOS/$spec/.git" ]]; then echo "$REPOS/$spec"; return; fi
  if [[ -d "$spec/.git" ]]; then (cd "$spec" && pwd -P); return; fi
  if [[ "$spec" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]; then
    dest="$REPOS/${spec##*/}"
    [[ -d "$dest/.git" ]] || gh repo clone "$spec" "$dest" >&2
  elif [[ "$spec" =~ ^(https?://|git@|ssh://) ]]; then
    base="$(basename "${spec%.git}")"
    dest="$REPOS/$base"
    [[ -d "$dest/.git" ]] || git clone "$spec" "$dest" >&2
  else
    die "can't resolve repo '$spec' (try owner/name, a git URL, or a local path)"
  fi
  echo "$dest"
}

base_ref() {
  local repo="$1" h
  if git -C "$repo" remote get-url origin >/dev/null 2>&1; then
    git -C "$repo" fetch --quiet origin || true
    h="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
    if [[ -n "$h" ]]; then echo "$h"; return; fi
  fi
  git -C "$repo" rev-parse --abbrev-ref HEAD
}

default_branch() {
  local h
  h="$(git -C "$1" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ -n "$h" ]]; then echo "${h#origin/}"; return; fi
  git -C "$1" symbolic-ref --quiet --short HEAD 2>/dev/null || echo main
}

# main and master are always protected, plus whatever the repo's default branch is.
is_protected_branch() {
  [[ "$2" == main || "$2" == master || "$2" == "$(default_branch "$1")" ]]
}

is_sandbox() { [[ "${MODE:-}" == sandbox ]]; }

# Status file for an agent: sandboxed agents write into their own mounted state dir.
status_file() { if is_sandbox; then echo "$STATE/$1.d/status"; else echo "$STATE/$1.status"; fi; }

# The host never runs git inside an agent-controlled directory (repo config can run commands).
# Anything that needs git in a sandbox clone runs in a throwaway container: no network,
# nothing mounted but the clone. SELinux labeling is off for these short-lived helpers so
# they can read a clone that a running agent container holds under a private label.
sb_git() {
  podman run --rm --network=none --security-opt=label=disable "${SB_FLAGS[@]}" \
    -v "$WORKTREE:/work" "$IMAGE" git "$@"
}

# Bring the agent's commits into the host repo as refs/heads/<branch>, via a git bundle
# (plain data, so nothing from the clone is executed on the host).
sb_pull() {
  local name="$1" dir
  dir="$STATE/$name.d"
  rm -f "$dir/out.bundle"
  if ! podman run --rm --network=none --security-opt=label=disable "${SB_FLAGS[@]}" \
         -v "$WORKTREE:/work" -v "$dir:/out" "$IMAGE" \
         git bundle create /out/out.bundle "$BRANCH" "^$BASE_SHA" >/dev/null 2>&1; then
    echo "no commits on $BRANCH yet" >&2
    return 1
  fi
  git -C "$REPO" -c fetch.fsckObjects=true fetch --quiet "$dir/out.bundle" "+refs/heads/$BRANCH:refs/heads/$BRANCH"
  rm -f "$dir/out.bundle"
}

# Git identity for commits made inside a sandbox, printed as "name<TAB>email". The container has
# no git config of its own, so without this every `git commit` fails with "Author identity unknown".
# Default: the host's git name and the GitHub noreply address of the logged-in gh account, so
# commits link to the account and no personal email lands in a public repo.
sb_git_identity() {
  local name="${AGENT_GIT_NAME:-}" email="${AGENT_GIT_EMAIL:-}" id="" login=""
  if [[ -z "$name" ]]; then name="$(git config --global user.name 2>/dev/null || true)"; fi
  if [[ -z "$name" || -z "$email" ]]; then
    read -r id login < <(gh api user --jq '"\(.id) \(.login)"' 2>/dev/null) || true
    if [[ -z "$name" ]]; then name="$login"; fi
    if [[ -z "$email" && -n "$id" ]]; then email="$id+$login@users.noreply.github.com"; fi
  fi
  [[ -n "$name" && -n "$email" ]] || die "can't work out a git identity for the sandbox; set AGENT_GIT_NAME and AGENT_GIT_EMAIL"
  printf '%s\t%s\n' "$name" "$email"
}

new_sandbox() {
  local repo="$1" repobase="$2" name="$3" branch="$4" base="$5" task="$6"
  local clone="$WORK/$repobase-$name" dir="$STATE/$name.d" sha head url ident gname gemail
  command -v podman >/dev/null || die "podman not found"
  podman image exists "$IMAGE" || die "image '$IMAGE' not found (run: agent image build)"
  podman secret exists "$TOKEN_SECRET" || die "secret '$TOKEN_SECRET' not found (run: agent token set)"
  ident="$(sb_git_identity)"
  gname="${ident%%$'\t'*}"
  gemail="${ident##*$'\t'}"
  [[ ! -e "$clone" ]] || die "$clone already exists"

  # The branch is created in the host repo at the base commit (or reused), so the sandbox gets
  # a private single-branch clone of it; its work comes back later through a bundle.
  sha="$(git -C "$repo" rev-parse "$base^{commit}")"
  git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" || git -C "$repo" branch --no-track "$branch" "$sha"
  git -c core.hooksPath=/dev/null clone -q --no-hardlinks --single-branch --branch "$branch" "$repo" "$clone"
  head="$(git -C "$clone" rev-parse --abbrev-ref HEAD)"
  if [[ "$head" != "$branch" ]] || is_protected_branch "$repo" "$head"; then
    rm -rf "$clone"
    die "refusing to start on '$head': agents must work on their own branch ($branch)"
  fi
  # Point origin at the real upstream (it has no credentials inside the sandbox) or drop it.
  if url="$(git -C "$repo" remote get-url origin 2>/dev/null)"; then
    git -C "$clone" remote set-url origin "$url"
    git -C "$clone" branch --unset-upstream "$branch" 2>/dev/null || true
  else
    git -C "$clone" remote remove origin
  fi

  mkdir -p "$dir"
  {
    printf 'MODE=sandbox\n'
    printf 'REPO=%q\n' "$repo"
    printf 'BRANCH=%q\n' "$branch"
    printf 'BASE=%q\n' "$base"
    printf 'BASE_SHA=%q\n' "$sha"
    printf 'WORKTREE=%q\n' "$clone"
    printf 'STARTED=%q\n' "$(now)"
  } > "$STATE/$name.env"
  if [[ -n "$task" ]]; then printf 'working %s\n' "$(now)" > "$dir/status"; else printf 'done %s\n' "$(now)" > "$dir/status"; fi

  local -a args=(podman run -it --rm --name "$(sess "$name")" "${SB_FLAGS[@]}"
    -v "$clone:/work:Z" -v "$dir:/agent-state:Z"
    --secret "$TOKEN_SECRET,type=env,target=CLAUDE_CODE_OAUTH_TOKEN"
    -e "AGENT_NAME=$name"
    -e "GIT_AUTHOR_NAME=$gname" -e "GIT_AUTHOR_EMAIL=$gemail"
    -e "GIT_COMMITTER_NAME=$gname" -e "GIT_COMMITTER_EMAIL=$gemail"
    "$IMAGE")
  # shellcheck disable=SC2206
  args+=($SANDBOX_CMD)
  if [[ -n "$task" ]]; then args+=("$task"); fi
  tmux new-session -d -s "$(sess "$name")" -c "$clone" "$(printf '%q ' "${args[@]}")"
  tmux set-option -t "$(sess "$name")" remain-on-exit on >/dev/null
  echo "started '$name' in a sandbox on $branch (base $base)"
  echo "  clone:    $clone"
  echo "  watch:    agent attach $name   |   agent peek $name"
  echo "  when done: agent diff $name   |   agent pr $name"
}

cmd_new() {
  local sandbox=0 edit=0 file=""
  while [[ "${1:-}" == -* && "${1:-}" != - ]]; do
    case "$1" in
      --sandbox|-s) sandbox=1; shift ;;
      --edit|-e) edit=1; shift ;;
      --file|-f) [[ $# -ge 2 ]] || die "$1 needs a path"; file="$2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [[ $# -ge 2 ]] || die "usage: agent new [--sandbox] [--edit | --file <path>] <repo> <name> [task... | -]"
  local spec="$1" name="$2"
  shift 2
  local task="$*"
  if [[ "$task" == "-" ]]; then
    task="$(cat)"
    [[ -n "${task//[[:space:]]/}" ]] || die "empty task on stdin"
  elif [[ -n "$file" ]]; then
    [[ -r "$file" ]] || die "cannot read $file"
    task="$(cat "$file")"
    [[ -n "${task//[[:space:]]/}" ]] || die "empty task in $file"
  elif (( edit )); then
    [[ -t 0 && -t 1 ]] || die "--edit needs a terminal"
    local ed="${VISUAL:-${EDITOR:-vi}}" tmp
    case "$ed" in code*|cursor*|subl*|windsurf*) ed="$ed --wait" ;; esac
    tmp="$(mktemp "${TMPDIR:-/tmp}/agent-task.XXXXXX.md")"
    # shellcheck disable=SC2086
    $ed "$tmp" || { rm -f "$tmp"; die "editor failed"; }
    task="$(cat "$tmp")"; rm -f "$tmp"
    [[ -n "${task//[[:space:]]/}" ]] || die "empty task, nothing started"
  fi
  [[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "name must match [a-z0-9-]+"
  [[ ! -e "$STATE/$name.env" ]] || die "agent '$name' already exists"
  if tmux has-session -t "$(sess "$name")" 2>/dev/null; then die "tmux session $(sess "$name") already exists"; fi

  mkdir -p "$REPOS" "$WORK" "$STATE"
  local repo repobase base branch wt excl head
  repo="$(resolve_repo "$spec")"
  repobase="$(basename "$repo")"
  branch="agent/$name"
  wt="$WORK/$repobase-$name"
  base="$(base_ref "$repo")"

  # Agents never start on the default branch: refuse before creating anything,
  # then verify what git actually checked out.
  if is_protected_branch "$repo" "$branch"; then
    die "refusing: '$branch' is a protected branch; agents must work on their own branch"
  fi
  if [[ "$sandbox" == 1 ]]; then
    new_sandbox "$repo" "$repobase" "$name" "$branch" "$base" "$task"
    return
  fi
  if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo" worktree add "$wt" "$branch" >&2
  else
    git -C "$repo" worktree add --no-track -b "$branch" "$wt" "$base" >&2
  fi
  head="$(git -C "$wt" rev-parse --abbrev-ref HEAD)"
  if [[ "$head" != "$branch" ]] || is_protected_branch "$repo" "$head"; then
    git -C "$repo" worktree remove --force "$wt" >&2 || true
    die "refusing to start on '$head': agents must work on their own branch ($branch)"
  fi

  # Per-worktree permission allowlist; keep it out of git.
  excl="$(git -C "$repo" rev-parse --path-format=absolute --git-path info/exclude)"
  grep -qxF '.claude/settings.local.json' "$excl" 2>/dev/null || echo '.claude/settings.local.json' >> "$excl"
  write_allowlist
  mkdir -p "$wt/.claude"
  [[ -e "$wt/.claude/settings.local.json" ]] || cp "$ALLOWLIST" "$wt/.claude/settings.local.json"

  {
    printf 'REPO=%q\n' "$repo"
    printf 'BRANCH=%q\n' "$branch"
    printf 'BASE=%q\n' "$base"
    printf 'WORKTREE=%q\n' "$wt"
    printf 'STARTED=%q\n' "$(now)"
  } > "$STATE/$name.env"

  local cmd
  local scope=""
  # Resource-limit the agent when a systemd user session exists (not on CI runners); AGENT_NO_SCOPE=1 skips it.
  if [[ "${AGENT_NO_SCOPE:-0}" != 1 ]]; then
    scope="systemd-run --user --scope --quiet -p MemoryMax=$MEM_MAX -p CPUQuota=$CPU_QUOTA -- "
  fi
  cmd="env AGENT_NAME=$(printf %q "$name") AGENTS_HOME=$(printf %q "$AGENTS_HOME") ${scope}$AGENT_CMD"
  if [[ -n "$task" ]]; then cmd+=" $(printf %q "$task")"; fi
  tmux new-session -d -s "$(sess "$name")" -c "$wt" "$cmd"
  tmux set-option -t "$(sess "$name")" remain-on-exit on >/dev/null
  # Claude records folder trust per main repo; the first agent in a repo blocks on the prompt.
  if [[ "$(jq -r --arg p "$repo" '.projects[$p].hasTrustDialogAccepted // false' "$HOME/.claude.json" 2>/dev/null || echo false)" != true ]]; then
    set_status "$name" needs-you
    log_event "$name" needs-you "first agent in $repobase: attach and accept the folder-trust prompt once"
    echo "note: first agent in $repobase is waiting on Claude's folder-trust prompt; attach and accept once"
  elif [[ -n "$task" ]]; then set_status "$name" working
  else set_status "$name" done; fi
  echo "started '$name' on $branch (base $base)"
  echo "  worktree: $wt"
  echo "  watch:    agent attach $name   |   agent peek $name"
}

last_line() {
  tmux capture-pane -p -t "$1" -S -30 2>/dev/null \
    | grep -Ev '^[[:space:]│─╭╮╰╯┌┐└┘>?]*$' | tail -n1 \
    | sed 's/^[[:space:]]*//' | cut -c1-60 || true
}

cmd_ls() {
  shopt -s nullglob
  local files=("$STATE"/*.env) f name
  if (( ${#files[@]} == 0 )); then echo "no agents"; return; fi
  printf '%-14s %-16s %-10s %-5s %s\n' NAME REPO STATUS AGE LAST
  for f in "${files[@]}"; do
    name="$(basename "$f" .env)"
    (
      load "$name"
      s="$(sess "$name")"; status=gone; age=""; last=""
      if tmux has-session -t "$s" 2>/dev/null; then
        status=working; ts="$(now)"
        sf="$(status_file "$name")"
        [[ -f "$sf" ]] && read -r status ts < "$sf"
        [[ "$(tmux display-message -p -t "$s" '#{pane_dead}')" == 1 ]] && status=exited
        age="$(human_age $(( $(now) - ts )))"
        last="$(last_line "$s")"
      fi
      # Flag an agent whose worktree has been moved off its own branch (e.g. onto main).
      # Not for sandboxes: the host doesn't run git in an agent-controlled clone.
      if ! is_sandbox; then
        cur="$(git -C "$WORKTREE" rev-parse --abbrev-ref HEAD 2>/dev/null || true)"
        if [[ -n "$cur" && "$cur" != "$BRANCH" ]]; then status=OFF-BRANCH; last="on '$cur', expected '$BRANCH'"; fi
      fi
      repo_col="$(basename "$REPO")"
      if is_sandbox; then repo_col+="[sb]"; fi
      printf '%-14s %-16s %-10s %-5s %s\n' "$name" "$repo_col" "$status" "$age" "$last"
    )
  done
}

cmd_peek() {
  local name="${1:?usage: agent peek <name> [lines]}" n="${2:-40}"
  load "$name"
  tmux has-session -t "$(sess "$name")" 2>/dev/null || die "session for '$name' is gone"
  tmux capture-pane -p -t "$(sess "$name")" -S "-$n" \
    | awk '{ l[NR] = $0 } NF { p = NR } END { for (i = 1; i <= p; i++) print l[i] }'
}

cmd_attach() {
  local name="${1:?usage: agent attach <name>}"
  load "$name"
  tmux has-session -t "$(sess "$name")" 2>/dev/null || die "session for '$name' is gone"
  if [[ -n "${TMUX:-}" ]]; then exec tmux switch-client -t "$(sess "$name")"; fi
  exec tmux attach -t "$(sess "$name")"
}

cmd_diff() {
  local name="${1:?usage: agent diff <name>}"
  load "$name"
  if is_sandbox; then
    sb_pull "$name" || true
    echo "== $BRANCH (base: $BASE) [sandbox clone: $WORKTREE]"
    git -C "$REPO" log --oneline "$BASE_SHA..$BRANCH" || true
    git -C "$REPO" diff --stat "$BASE_SHA" "$BRANCH" || true
    echo "-- uncommitted in the sandbox clone:"
    sb_git status -sb || true
    return
  fi
  echo "== $BRANCH (base: $BASE) in $WORKTREE"
  git -C "$WORKTREE" log --oneline "$BASE..HEAD" || true
  git -C "$WORKTREE" status -sb
  git -C "$WORKTREE" diff --stat "$BASE" || true
}

cmd_log() {
  shopt -s nullglob
  local f files=()
  for f in "$EVENTS" "$STATE"/*.d/events; do [[ -f "$f" ]] && files+=("$f"); done
  (( ${#files[@]} > 0 )) || { echo "no events yet"; return; }
  cat "${files[@]}" | sort | tail -n "${1:-20}"
}

cmd_rm() {
  local name="${1:?usage: agent rm <name> [--force]}" force="${2:-}"
  [[ -z "$force" || "$force" == "--force" ]] || die "unknown option: $force"
  load "$name"
  if is_sandbox; then
    if [[ -d "$WORKTREE" && -z "$force" ]]; then
      [[ -z "$(sb_git status --porcelain)" ]] \
        || die "sandbox clone has uncommitted changes (agent rm $name --force to discard)"
    fi
    sb_pull "$name" || true     # keep committed work on the host branch
    tmux kill-session -t "$(sess "$name")" 2>/dev/null || true
    podman rm -f "$(sess "$name")" >/dev/null 2>&1 || true
    rm -rf "$WORKTREE" "$STATE/$name.d"
    rm -f "$STATE/$name.env"
    echo "removed '$name'; branch $BRANCH kept in $REPO (delete: git -C $REPO branch -D $BRANCH)"
    return
  fi
  if [[ -d "$WORKTREE" && -z "$force" ]]; then
    [[ -z "$(git -C "$WORKTREE" status --porcelain)" ]] \
      || die "worktree has uncommitted changes (agent rm $name --force to discard)"
  fi
  tmux kill-session -t "$(sess "$name")" 2>/dev/null || true
  if [[ -d "$WORKTREE" ]]; then git -C "$REPO" worktree remove ${force:+--force} "$WORKTREE"; fi
  rm -f "$STATE/$name.env" "$STATE/$name.status"
  echo "removed '$name'; branch $BRANCH kept (delete: git -C $REPO branch -D $BRANCH)"
}

# Push the agent's branch (and only that branch) using the host's GitHub login.
# GitHub credentials never enter a sandbox; this always runs on the host.
cmd_push() {
  local name="${1:?usage: agent push <name>}"
  load "$name"
  if is_sandbox; then
    sb_pull "$name" || die "nothing to push: no commits on $BRANCH"
  fi
  is_protected_branch "$REPO" "$BRANCH" && die "refusing to push protected branch '$BRANCH'"
  git -C "$REPO" remote get-url origin >/dev/null 2>&1 || die "repo has no origin remote"
  git -C "$REPO" -c credential.helper= -c 'credential.helper=!gh auth git-credential' \
    push -u origin "$BRANCH:$BRANCH"
}

# Push the branch and open a PR against the default branch. Extra args go to `gh pr create`.
cmd_pr() {
  local name="${1:?usage: agent pr <name> [gh pr create args]}"
  shift
  cmd_push "$name"
  (cd "$REPO" && gh pr create --head "$BRANCH" --base "$(default_branch "$REPO")" --fill "$@")
}

cmd_image() {
  case "${1:-}" in
    build)
      [[ -f "$AGENTS_HOME/sandbox/Containerfile" ]] || die "no Containerfile in $AGENTS_HOME/sandbox (run scripts/install-agent.sh from the repo)"
      podman build -t "$IMAGE" -f "$AGENTS_HOME/sandbox/Containerfile" "$AGENTS_HOME/sandbox" ;;
    *) die "usage: agent image build" ;;
  esac
}

# The Claude token the sandbox uses lives in a Podman secret, never on a command line.
cmd_token() {
  local t
  case "${1:-}" in
    set)
      echo "Run 'claude setup-token' (needs a Claude subscription), then paste the token here." >&2
      read -rsp "token: " t; echo >&2
      [[ -n "$t" ]] || die "empty token"
      printf '%s' "$t" | podman secret create --replace "$TOKEN_SECRET" - >/dev/null
      echo "stored as podman secret '$TOKEN_SECRET'" ;;
    status)
      if podman secret exists "$TOKEN_SECRET"; then echo "secret '$TOKEN_SECRET': present"; else echo "secret '$TOKEN_SECRET': missing"; fi ;;
    rm)
      podman secret rm "$TOKEN_SECRET" ;;
    *) die "usage: agent token set|status|rm" ;;
  esac
}

# Called by Claude Code hooks: agent hook <working|needs-you|done>
cmd_hook() {
  local event="${1:?}" name="${AGENT_NAME:-}" payload="" msg=""
  [[ -n "$name" && -d "$STATE" ]] || exit 0
  if [[ "$event" == needs-you ]]; then
    payload="$(cat || true)"
    msg="$(printf '%s' "$payload" | jq -r '.message // empty' 2>/dev/null || true)"
    # Claude's idle reminder arrives as a Notification; don't mask "done" with it.
    if [[ "$msg" == *"waiting for your input"* ]]; then exit 0; fi
  fi
  set_status "$name" "$event"
  if [[ "$event" != working ]]; then log_event "$name" "$event" "$msg"; fi
}

install_hooks() {
  local settings="$HOME/.claude/settings.json" tmp
  mkdir -p "$HOME/.claude"
  [[ -f "$settings" ]] || echo '{}' > "$settings"
  cp "$settings" "$settings.bak-$(now)"
  tmp="$(mktemp)"
  jq --arg c "$BIN" '
    def add($ev; $arg):
      .hooks[$ev] = ((.hooks[$ev] // [])
        | map(select(((.hooks // []) | any((.command // "") | startswith($c))) | not))
        + [{"hooks": [{"type": "command", "command": ($c + " hook " + $arg)}]}]);
    .hooks //= {}
    | add("UserPromptSubmit"; "working")
    | add("PostToolUse"; "working")
    | add("Notification"; "needs-you")
    | add("Stop"; "done")
  ' "$settings" > "$tmp"
  mv "$tmp" "$settings"
  echo "hooks installed in $settings (backup: $settings.bak-*)"
}

write_allowlist() {
  mkdir -p "$AGENTS_HOME"
  if [[ ! -f "$ALLOWLIST" ]]; then
    cat > "$ALLOWLIST" <<'EOF'
{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(ruff:*)",
      "Bash(uv run ruff:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(make test:*)"
    ]
  }
}
EOF
    echo "wrote $ALLOWLIST (copied into each new worktree; edit to taste)" >&2
  fi
}

cmd_setup() {
  mkdir -p "$REPOS" "$WORK" "$STATE" "$HOME/.local/bin"
  write_allowlist
  install_hooks
}

command -v tmux >/dev/null || die "tmux not found"
# Remove agents whose work has landed: a merged PR whose head is exactly the branch tip.
# Anything else (no PR, open PR, commits after the merge, uncommitted changes) is kept.
cmd_clean() {
  local dry=0 names=() n f kept=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--dry-run) dry=1 ;;
      -*) die "unknown option: $1" ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  if (( ${#names[@]} == 0 )); then
    shopt -s nullglob
    for f in "$STATE"/*.env; do names+=("$(basename "$f" .env)"); done
  fi
  (( ${#names[@]} )) || { echo "no agents"; return; }
  for n in "${names[@]}"; do
    (
      load "$n"
      if is_sandbox; then sb_pull "$n" >/dev/null 2>&1 || true; fi   # newest commits onto the host branch
      tip="$(git -C "$REPO" rev-parse --verify -q "refs/heads/$BRANCH" || true)"
      [[ -n "$tip" ]] || { echo "keep  $n: no branch $BRANCH on the host (nothing committed)"; exit 3; }
      merged="$(cd "$REPO" && gh pr list --head "$BRANCH" --state merged --json headRefOid --jq '.[].headRefOid' 2>/dev/null || true)"
      grep -qx "$tip" <<<"$merged" || { echo "keep  $n: no merged PR ending at the tip of $BRANCH"; exit 3; }
      if (( dry )); then echo "would clean $n (remove agent, delete $BRANCH)"; exit 0; fi
      cmd_rm "$n" >/dev/null     # refuses (exit 1) if there are uncommitted changes
      git -C "$REPO" branch -D "$BRANCH" >/dev/null
      echo "cleaned $n (deleted $BRANCH)"
    ) || kept=$((kept + 1))
  done
  (( kept == 0 )) || echo "$kept kept; 'agent rm <name>' removes one regardless"
}

case "${1:-}" in
  new)         shift; cmd_new "$@" ;;
  ls|list)     cmd_ls ;;
  peek)        shift; cmd_peek "$@" ;;
  attach)      shift; cmd_attach "$@" ;;
  diff)        shift; cmd_diff "$@" ;;
  log)         shift; cmd_log "$@" ;;
  rm)          shift; cmd_rm "$@" ;;
  clean)       shift; cmd_clean "$@" ;;
  push)        shift; cmd_push "$@" ;;
  pr)          shift; cmd_pr "$@" ;;
  image)       shift; cmd_image "$@" ;;
  token)       shift; cmd_token "$@" ;;
  hook)        shift; cmd_hook "$@" ;;
  setup)       cmd_setup ;;
  ""|-h|--help|help) usage ;;
  *)           usage >&2; exit 1 ;;
esac
